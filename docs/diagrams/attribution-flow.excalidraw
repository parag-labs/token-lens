    {
      "type": "text",
      "id": "text-18",
      "x": 60,
      "y": 540,
      "width": 860,
      "height": 35,
      "text": "Median over mean on purpose: a single huge outlier can't drag the baseline up and",
      "fontSize": 14,
      "fontFamily": 1,
      "strokeColor": "#000000",
      "textAlign": "left",
      "verticalAlign": "top"
    },
    {
      "type": "text",
      "id": "text-19",
      "x": 60,
      "y": 572,
      "width": 860,
      "height": 35,
      "text": "hide its neighbours. The cardinality-bound memory is what lets it face a real firehose",
      "fontSize": 14,
      "fontFamily": 1,
      "strokeColor": "#000000",
      "textAlign": "left",
      "verticalAlign": "top"
    },
    {
      "type": "text",
      "id": "text-20",
      "x": 60,
      "y": 604,
      "width": 860,
      "height": 35,
      "text": "instead of becoming the expensive thing it measures.",
      "fontSize": 14,
      "fontFamily": 1,
      "strokeColor": "#000000",
      "textAlign": "left",
      "verticalAlign": "top"
    }
  ],
